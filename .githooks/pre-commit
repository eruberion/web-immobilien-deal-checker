#!/usr/bin/env bash
set -euo pipefail

GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
PRIMARY_REPO_ROOT="$(cd "$(dirname "$GIT_COMMON_DIR")" && pwd)"
DEV_ROOT="$(cd "$PRIMARY_REPO_ROOT/../.." && pwd)"
OPENCLAW_HOOK="$DEV_ROOT/Apps/ZZZ_OpenClaw/.githooks/pre-commit"
INSTALL_SCRIPT="$DEV_ROOT/Apps/ZZZ_OpenClaw/scripts/install_workspace_git_hooks.sh"

if [[ ! -x "$OPENCLAW_HOOK" ]]; then
  echo "[policy-sync] missing shared hook: $OPENCLAW_HOOK"
  echo "[policy-sync] run $INSTALL_SCRIPT to restore."
  exit 1
fi

exec "$OPENCLAW_HOOK" "$@"
